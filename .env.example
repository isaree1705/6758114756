# SERVER ONLY. Copy to .env.local; never commit real values.
# Supabase Connect > Transaction pooler (port 6543).
# Replace the default postgres username with idea_board_app.PROJECT_REF.
DATABASE_URL=postgresql://idea_board_app.PROJECT_REF:YOUR_APP_ROLE_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# Generate a separate random secret of at least 32 characters; keep it stable.
VOTER_COOKIE_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
